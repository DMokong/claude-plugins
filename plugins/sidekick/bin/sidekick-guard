def base(word):
    """A command's name: no directory, and no case (the disk may not tell RM from rm)."""
    return os.path.basename(word).lower()


def interpreter_key(name):
    """`python3.12` -> python."""
    return re.sub(r"[0-9.]+$", "", name)


ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*\+?=")


class Word(str):
    """A word of a command line, with what the shell will do to it that the text no longer shows."""
    glob = False  # an unquoted glob character: the shell picks the real name
    unknown = False  # a variable or substitution the guard could not resolve
    alts = ()  # every plain text it can become once variables are filled in


def strip_wrappers(words):
    """`env FOO=1 nohup timeout 5 cmd ...` -> (`env FOO=1 nohup timeout 5`, `cmd ...`)."""
    i = 0
    while i < len(words):
        w = words[i]
        if ASSIGNMENT.match(w):
            i += 1
            continue
        name = base(w)
        if name not in WRAPPERS:
            break
        valued = WRAPPERS[name]
        i += 1
        while i < len(words) and words[i].startswith("-") and words[i] != "-":
            o = words[i]
            if name == "env" and (o == "-S" or o == "--split-string" or o.startswith("--split-string=") or (o.startswith("-S") and not o.startswith("--"))):
                value = o.split("=", 1)[1] if o.startswith("--split-string=") else (o[2:] if len(o) > 2 and not o.startswith("--") else (words[i + 1] if i + 1 < len(words) else ""))
                used = i + (1 if (o.startswith("--split-string=") or (len(o) > 2 and not o.startswith("--"))) else 2)
                try:
                    spliced = shlex.split(value)
                except ValueError:
                    spliced = value.split()
                prefix, rest = strip_wrappers(spliced + list(words[used:]))
                return list(words[:used]) + prefix, rest
            i += 2 if o in valued else 1
            if o == "--":
                break
        if name in TAKES_A_DURATION:
            i += 1
    return list(words[:i]), list(words[i:])


def texts(words):
    """Every command line the words can make when joined (each word's variables filled in every way it can be)."""
    combos = [[]]
    for w in words:
        alts = getattr(w, "alts", None) or [str(w)]
        combos = [c + [a] for c in combos for a in alts][:64]
    return [" ".join(c) for c in combos]


def first_refusal(again, lines):
    for line in lines:
        why = again(line)
        if why:
            return why
    return None


def dangerous_assignment(words):
    for w in words:
        if DANGEROUS_ASSIGNMENTS.match(w):
            return f"setting {w.split('=')[0]} can make a program run another one"
    return None


def first_positional(args, with_value=()):
    i = 0
    while i < len(args):
        a = args[i]
        if a in with_value:
            i += 2
            continue
        if a.startswith("-"):
            i += 1
            continue
        return i
    return None


def docker_refusal(args, check):
    i = 0
    while i < len(args) and args[i].startswith("-"):
        i += 2 if args[i] in DOCKER_GLOBAL_WITH_VALUE else 1
    if i >= len(args):
        return None
    sub, rest = args[i], args[i + 1:]
    if sub in DOCKER_GROUP_READS:
        group = sub
        j = 0
        if group == "compose":
            while j < len(rest) and rest[j].startswith("-"):
                j += 2 if rest[j] in COMPOSE_WITH_VALUE else 1
        if j >= len(rest):
            return None
        sub, rest = rest[j], rest[j + 1:]
        if sub not in DOCKER_GROUP_READS[group]:
            return f"docker {group} {sub} changes or removes containers or data"
    elif sub not in DOCKER_READS:
        return f"docker {sub} changes or removes containers or data"
    if sub == "exec":
        j = 0
        while j < len(rest) and rest[j].startswith("-") and rest[j] != "--":
            a = rest[j]
            if a.startswith("--"):
                j += 2 if a in DOCKER_EXEC_WITH_VALUE else 1
            else:
                j += 2 if any(v == "" for _, v in shorts(a, "euw")) else 1
        if j < len(rest) and rest[j] == "--":
            j += 1
        inner = rest[j + 1:]  # past the container (or compose service)
        return check(inner) if inner else None
    return None


def sql_text_refusal(name, sql):
    if SQL_WRITES.search(sql):
        return f"{name} query changes data"
    for meta in re.findall(r"\\\S*", sql):
        if not SQL_SAFE_META.match(meta + " "):
            return f"{name} query runs a meta-command the guard can't check"
    for line in sql.splitlines():
        line = line.strip()
        if line.startswith(".") and line.split()[0] not in SQLITE_SAFE_DOT:
            return f"{name} dot-command can run programs or write files"
    return None


def sql_refusal(name, args):
    inline, files, listing = [], False, False
    if name in ("psql", "mysql", "mariadb"):
        valued = "cdfhLopPRTUvF" if name == "psql" else "ehuPDSp"
        inline_letter, file_letters = ("c", "fLo") if name == "psql" else ("e", "")
        inline_long = ("command",) if name == "psql" else ("execute", "init-command")
        file_long = ("file", "output", "log-file") if name == "psql" else ()
        i = 0
        while i < len(args):
            a = args[i]
            i += 1
            if a.startswith("--"):
                given, eq, val = a[2:].partition("=")
                if given in ("list", "version"):
                    listing = True
                elif given and any(n.startswith(given) for n in inline_long):
                    inline.append(val if eq else (args[i] if i < len(args) else ""))
                    i += 0 if eq else 1
                elif given and any(n.startswith(given) for n in file_long):
                    files = True
            elif a.startswith("-") and len(a) > 1:
                for ch, val in shorts(a, valued):
                    if ch in ("l", "V"):
                        listing = True
                    if ch == inline_letter:
                        inline.append(val if val else (args[i] if i < len(args) else ""))
                        i += 0 if val else 1
                    elif ch in file_letters:
                        files = True
                        i += 0 if val else 1
                    elif val == "":
                        i += 1
    else:
        positional = []
        i = 0
        while i < len(args):
            a = args[i]
            i += 1
            if a in ("-cmd", "-c", "-s") and name == "duckdb" or a == "-cmd":
                inline.append(args[i] if i < len(args) else "")
                i += 1
            elif a in ("-init", "-f") and (name == "duckdb" or a == "-init"):
                files = True
            elif a in ("-version", "-help", "--version", "--help"):
                listing = True
            elif a in ("-separator", "-newline", "-nullvalue", "-cmd", "-vfs"):
                i += 1
            elif not a.startswith("-"):
                positional.append(a)
        inline += positional[1:]
    if files:
        return f"{name} reads SQL from a file the guard can't check"
    for sql in inline:
        why = sql_text_refusal(name, sql)
        if why:
            return why
    if not inline and not listing:
        return f"{name} without an inline query reads its SQL from somewhere the guard can't check"
    return None


def redis_refusal(args):
    if any(a.startswith(REDIS_WRITING) for a in args):
        return "redis-cli option that writes a file or reads commands the guard can't see"
    k = first_positional(args, REDIS_WITH_VALUE)
    if k is None:
        return "redis-cli without a command reads it from somewhere the guard can't check"
    command = args[k].lower()
    if command not in REDIS_READS:
        return f"redis-cli {args[k]} changes data"
    sub = [a.lower() for a in args[k + 1:k + 2]]
    if command == "client" and sub not in ([], ["list"], ["info"]):
        return "redis-cli client changes connections"
    if command in REDIS_SUBREADS and (not sub or sub[0] not in REDIS_SUBREADS[command]):
        return f"redis-cli {command} {sub[0] if sub else ''} changes the server".replace("  ", " ")
    return None


CURL_VALUED = "AbcCdDeEFHKmoPQrtTuUwxXyYz"
# Options that send data, upload, write a file of their own or read options the guard can't see.
CURL_ALWAYS = ["data", "data-ascii", "data-binary", "data-raw", "data-urlencode", "json", "form", "form-string", "upload-file", "mail-from", "mail-rcpt", "remote-name", "remote-name-all", "remote-header-name", "config"]
# Options that write to the file they are given: fine to /dev/null or to the screen.
CURL_TO_FILE = {"output": "o", "dump-header": "D", "cookie-jar": "c", "trace": "", "trace-ascii": "", "stderr": "", "libcurl": "", "etag-save": "", "hsts": "", "alt-svc": ""}
CURL_EXACT_OTHER = {"cookie"}
HARMLESS_TARGETS = ("-", "/dev/null", "/dev/stdout", "/dev/stderr")


def curl_refusal(args):
    i = 0
    while i < len(args):
        a = args[i]
        i += 1
        if a == "--":
            break
        nxt = args[i] if i < len(args) else ""
        if a.startswith("--"):
            given, eq, val = a[2:].partition("=")
            if given in CURL_EXACT_OTHER:
                i += 0 if eq else 1
            elif long_in(a, CURL_ALWAYS):
                return "curl writes to an API or a file"
            elif long_in(a, ["request"]) and given != "request-target":
                v = val if eq else nxt
                i += 0 if eq else 1
                if v.upper() not in ("GET", "HEAD"):
                    return "curl writes to an API"
            elif long_in(a, list(CURL_TO_FILE)):
                v = val if eq else nxt
                i += 0 if eq else 1
                if v not in HARMLESS_TARGETS:
                    return "curl writes a file"
            elif long_in(a, ["write-out"]):
                v = val if eq else nxt
                i += 0 if eq else 1
                if "%output" in v or v.startswith("@"):
                    return "curl -w can write a file"
        elif a.startswith("-") and len(a) > 1:
            for ch, val in shorts(a, CURL_VALUED):
                if ch in "dFTOJK":
                    return "curl writes to an API or a file" if ch != "K" else "curl -K reads options the guard can't see"
                if val == "" and ch in CURL_VALUED:
                    i += 1
                if ch == "X":
                    v = val or nxt
                    if v.upper() not in ("GET", "HEAD"):
                        return "curl writes to an API"
                elif ch in "oDc":
                    if (val or nxt) not in HARMLESS_TARGETS:
                        return "curl writes a file"
                elif ch == "w":
                    v = val or nxt
                    if "%output" in v or v.startswith("@"):
                        return "curl -w can write a file"
    return None


WGET_WRITES = ["post-data", "post-file", "method", "body-data", "body-file", "output-file", "append-output", "save-cookies", "background", "warc-file"]
WGET_VALUED = "OoaPeiUtTQwlIRXBAD"


def wget_refusal(args):
    to_stdout, i = False, 0
    while i < len(args):
        a = args[i]
        i += 1
        if a == "--":
            break
        nxt = args[i] if i < len(args) else ""
        if a.startswith("--"):
            given, eq, val = a[2:].partition("=")
            if given and "output-document".startswith(given) and not any(n.startswith(given) for n in WGET_WRITES):
                v = val if eq else nxt
                i += 0 if eq else 1
                to_stdout = v in ("-", "/dev/null")
            elif long_in(a, WGET_WRITES):
                return "wget writes to an API or a file"
        elif a.startswith("-") and len(a) > 1:
            for ch, val in shorts(a, WGET_VALUED):
                if ch in "oab":
                    return "wget writes a log file or runs in the background"
                if ch == "O":
                    to_stdout = (val or nxt) in ("-", "/dev/null")
                if val == "" and ch in WGET_VALUED:
                    i += 1
    return None if to_stdout else "wget writes a file"


def tar_refusal(args):
    ops = set()
    for k, a in enumerate(args):
        if a.startswith("--"):
            given = a[2:].split("=", 1)[0]
            if len(given) >= 2:
                ops |= {op for name, op in TAR_LONG_OPS.items() if name.startswith(given)}
        elif a.startswith("-") and len(a) > 1:
            ops |= set(a[1:]) & set("xcruA")
        elif k == 0:
            ops |= set(a) & set("xcruA")
    if ops:
        return "tar extracts or writes files"
    return None


def shell_refusal(name, args, again):
    """A shell's command line is a program: the string after -c is checked as one.

    -c may be anywhere in a bundle of flags (-lc, -euxo pipefail -c, -l -c); -o and -O in a bundle
    take the next word, so the scan must step over it to reach the -c behind it.
    """
    i, has_c, stdin, fish_init = 0, False, False, []
    while i < len(args):
        a = args[i]
        if a == "--":
            i += 1
            break
        if a == "-":
            stdin = True
            i += 1
            continue
        if not a.startswith(("-", "+")):
            break
        if a.startswith("--"):
            given, eq, val = a[2:].partition("=")
            if given in ("rcfile", "init-file"):
                i += 1 if eq else 2
                continue
            if given == "command":  # fish
                if eq:
                    fish_init.append(val)
                else:
                    has_c = True
            elif given == "init-command":
                fish_init.append(val if eq else (args[i + 1] if i + 1 < len(args) else ""))
                i += 0 if eq else 1
            i += 1
            continue
        step, k = 1, 1
        while k < len(a):
            ch = a[k]
            if ch == "c":
                has_c = True
            elif ch == "s":
                stdin = True
            elif ch in "oO":
                step = 2
            elif ch == "C" and name == "fish":
                fish_init.append(a[k + 1:] or (args[i + 1] if i + 1 < len(args) else ""))
                step = 1 if a[k + 1:] else 2
                break
            k += 1
        i += step
    for init in fish_init:
        why = again(init)
        if why:
            return why
    if has_c:
        if i >= len(args):
            return "a shell with no command"
        for t in texts([args[i]]):
            why = again(t)
            if why:
                return why
        return None
    if stdin or i >= len(args):
        return "a shell reading commands the guard can't see"
    return None  # a script: the project's own, its maintainers' choice


def interpreter_refusal(key, args):
    inline_letters = INLINE_LETTERS.get(key, "ce")
    stop = STOP_LETTERS.get(key, "")
    place = IN_PLACE_LETTERS.get(key, "")
    message = f"{key} running inline code the guard can't see into"
    i = 0
    while i < len(args):
        a = args[i]
        if a == "-":
            return message
        if a == "--":
            i += 1
            break
        if not a.startswith("-"):
            break
        if a.startswith("--"):
            if a.startswith(INLINE_LONG):
                return message
            i += 1
            continue
        for n, ch in enumerate(a[1:], 1):
            if ch in place:
                return f"{key} -{ch} edits files in place"
            if ch in inline_letters:
                return message
            if ch == "m" and key in ("python", "pypy"):
                module = a[n + 1:] or (args[i + 1] if i + 1 < len(args) else "")
                return None if module in PYTHON_MODULES else f"{key} -m runs a module the guard can't see into"
            if ch in stop:
                break
        i += 2 if a in ("-W", "-X", "-Q") else 1
    if i >= len(args):
        return message
    if key == "deno" and args[i] in DENO_CODE:
        return f"deno {args[i]} runs code or changes installs"
    return None


def sed_refusal(args):
    programs, explicit, i = [], False, 0
    positional = []
    while i < len(args):
        a = args[i]
        i += 1
        if a == "--":
            positional += args[i:]
            break
        if a.startswith("--"):
            given, eq, val = a[2:].partition("=")
            if long_in(a, ["file"]):
                return "sed -f runs a script the guard can't see"
            if long_in(a, ["in-place"]):
                return "sed -i edits files in place"
            if long_in(a, ["expression"]):
                programs.append(val if eq else (args[i] if i < len(args) else ""))
                i += 0 if eq else 1
                explicit = True
        elif a.startswith("-") and len(a) > 1:
            for ch, val in shorts(a, "efl"):
                if ch == "f":
                    return "sed -f runs a script the guard can't see"
                if ch == "i":
                    return "sed -i edits files in place"
                if ch == "e":
                    programs.append(val or (args[i] if i < len(args) else ""))
                    i += 0 if val else 1
                    explicit = True
                elif ch == "l" and not val:
                    i += 1
        else:
            positional.append(a)
    if not explicit and positional:
        programs.append(positional[0])
    for program in programs:
        if re.search(r"(^|[;{}\n]|^\s*[0-9$,/]*[^/]*)\s*[wWe](\s|$)", program) or re.search(r"/[gpIiMm0-9]*[we](\s|$|;)", program):
            return "sed script writes files or runs commands"
        why = script_refusal(program)
        if why:
            return why
    return None


def awk_refusal(args):
    programs, i, explicit = [], 0, False
    while i < len(args):
        a = args[i]
        i += 1
        if a == "--":
            break
        if not a.startswith("-") or a == "-":
            i -= 1
            break
        if a.startswith("--"):
            if long_in(a, ["file", "include", "load", "exec"]):
                return "awk --file runs a program the guard can't see"
            if long_in(a, ["source"]):
                programs.append(a.split("=", 1)[1] if "=" in a else (args[i] if i < len(args) else ""))
                i += 0 if "=" in a else 1
                explicit = True
            continue
        for ch, val in shorts(a, "FveW"):
            if ch in "fiEl":
                return "awk -f runs a program the guard can't see"
            if ch == "e":
                programs.append(val or (args[i] if i < len(args) else ""))
                i += 0 if val else 1
                explicit = True
            elif ch in "Fv" and not val:
                i += 1
            elif ch == "W":
                i += 0 if val else 1
    if not explicit and i < len(args):
        programs.append(args[i])
    for program in programs:
        if "inplace" in program or re.search(r"system\s*\(|\|\s*getline|(print|printf)[^;}]*(>|\|)|fflush|close\s*\(", program):
            return "awk program runs commands or writes files"
        why = script_refusal(program)
        if why:
            return why
    return None


def simple_refusal(words, profile, check, again):
    """Why one simple command (no pipes or chains left in it) is refused, or None."""
    first = base(words[0])
    prefix, words = strip_wrappers(words)
    why = dangerous_assignment(prefix)
    if why:
        return why
    if not words:
        if first == "env" and profile == "investigate":
            return "env prints environment variables, secrets included"
        return None
    if "$" in words[0] or "`" in words[0] or getattr(words[0], "glob", False) or words[0].startswith("="):
        return "a command name the guard can't see until the shell expands it"
    path, args = words[0], words[1:]
    name = base(path)
    if name.startswith("g") and name[1:] in G_TOOLS:
        name = name[1:]
    # Shell syntax: a loop or case header holds no command (its $(...) is checked on its own);
    # `do`, `then` and the like lead into the command after them.
    if name in ("for", "select", "case", "function", "in", "esac", "done", "fi", "}", "]]", "[["):
        return None
    if name in ("do", "then", "else", "elif", "while", "until", "if", "!", "{"):
        return check(args) if args else None
    if name in ("export", "local", "readonly", "declare", "typeset") and [a for a in args if not a.startswith("-")]:
        return dangerous_assignment(args)
    if name in ("source", "."):
        if not args:
            return "source with nothing to read"
        if args[0] in ("-", "/dev/stdin") or args[0].startswith(("/dev/fd/", "/proc/")):
            return "source reading commands the guard can't see"
        return None
    if name in ("busybox", "toybox") and args:
        return check(args)
    if name == "repeat" and len(args) >= 2:  # zsh: repeat 3 cmd ...
        return check(args[1:])
    if name in ("setopt", "unsetopt") and args or name == "shopt" and any(letter in "su" for a in args for letter, _ in shorts(a)):
        return "changing the shell's options changes how it expands words"
    if name in ALWAYS_REFUSED:
        return f"{name} {ALWAYS_REFUSED[name]}"
    if name == "eval":
        return first_refusal(again, texts(args))
    if name == "trap":
        return first_refusal(again, texts(args[:1])) if args and not args[0].startswith("-") else None
    if name == "watch":
        # -d takes no separate value; and watch runs what is left through `sh -c`, as one string.
        j = 0
        while j < len(args) and args[j].startswith("-"):
            j += 2 if args[j] in ("-n", "--interval") else 1
        return first_refusal(again, texts(args[j:])) if j < len(args) else None
    if name in SHELLS:
        return shell_refusal(name, args, again)
    key = interpreter_key(name)
    if key in INTERPRETERS:
        return interpreter_refusal(key, args)
    if name == "xargs":
        j = 0
        while j < len(args) and args[j].startswith("-"):
            j += 2 if args[j] in ("-I", "-n", "-P", "-L", "-s", "-E", "-d", "-J", "-R", "-S", "-a", "--arg-file", "--delimiter", "--max-args", "--max-procs", "--max-lines", "--max-chars", "--eof") else 1
        return check(args[j:]) if j < len(args) else None
    if name == "find":
        if any(a in ("-delete", "-fprint", "-fprint0", "-fprintf", "-fls") for a in args):
            return "find -delete removes files"
        for k, a in enumerate(args):
            if a in ("-exec", "-execdir", "-ok", "-okdir"):
                inner = []
                for b in args[k + 1:]:
                    if b in (";", "+", "\\;"):
                        break
                    inner.append(b)
                why = check(inner)
                if why:
                    return why
        return None
    if name == "sed":
        return sed_refusal(args)
    if name in ("awk", "gawk", "nawk", "mawk"):
        return awk_refusal(args)
    if name == "rg" and any(a.startswith(("--pre", "--hostname-bin")) for a in args):
        return "rg --pre runs a program on every file"
    if name == "uniq" and len([a for a in args if not a.startswith("-")]) > 1:
        return "uniq writes its second file"
    if name == "tee" and any(not a.startswith("-") and a != "/dev/null" for a in args):
        return "tee writes a file"
    if name == "dd" and any(a.startswith("of=") for a in args):
        return "dd writes a file"
    if name == "sort" and any(letter == "o" for a in args for letter, _ in shorts(a, "ktTS")) or name == "sort" and any(long_in(a, ["output", "compress-program"]) for a in args):
        return "sort -o writes a file"
    if name == "xxd" and len(positionals(args, {"-c", "-g", "-l", "-s", "-o"})) > 1:
        return "xxd writes its second file"
    if name == "base64" and any(letter == "o" for a in args for letter, _ in shorts(a, "io")):
        return "base64 -o writes a file"
    if name == "tree" and any(letter == "o" for a in args for letter, _ in shorts(a, "LPIoHT")):
        return "tree -o writes a file"
    if name == "yq" and (any(letter == "i" for a in args for letter, _ in shorts(a, "Iopf")) or any(long_in(a, ["inplace"]) for a in args)):
        return "yq -i edits files in place"
    if name in ("tar", "bsdtar", "gtar"):
        return tar_refusal(args)
    if name in ("gzip", "gunzip", "bzip2", "bunzip2", "xz", "unxz", "zstd"):
        # -c (to the screen), -l (list) and -t (test) leave the file alone, bundled or not; -o names a file.
        reads_only = any(letter in "clt" for a in args for letter, _ in shorts(a)) or any(long_in(a, ["stdout", "list", "test"]) for a in args)
        if not reads_only or any(letter == "o" for a in args for letter, _ in shorts(a)) or any(long_in(a, ["output"]) for a in args):
            return f"{name} replaces files"
    if name == "curl":
        return curl_refusal(args)
    if name == "wget":
        return wget_refusal(args)
    if name == "docker":
        return docker_refusal(args, check)
    if name == "docker-compose":
        return docker_refusal(["compose"] + args, check)
    if name == "launchctl":
        sub = args[0] if args else ""
        return None if sub in LAUNCHCTL_READS or sub == "" else f"launchctl {sub} changes jobs (restart with launchctl kickstart -k)"
    if name == "systemctl":
        k = first_positional(args)
        sub = args[k] if k is not None else ""
        return None if sub in ("status", "is-active", "is-failed", "list-units", "list-timers", "show", "restart", "cat", "") else f"systemctl {sub} changes services"
    if name == "brew":
        k = first_positional(args)
        sub = args[k] if k is not None else ""
        if sub == "services":
            action = args[k + 1] if k + 1 < len(args) else "list"
            return None if action in ("list", "info", "restart", "start") else f"brew services {action} changes services"
        return None if sub in BREW_READS or sub == "" else f"brew {sub} changes installed software"
    if name in INSTALLERS:
        for a in args:
            if a == "--":
                break
            if a.startswith("-"):
                continue
            if a in INSTALL_WORDS:
                return f"{name} {a} changes installed software"
            if a in INSTALLER_READS:
                break
        if "audit" in args and "fix" in args:
            return f"{name} audit fix changes installed software"
        if name == "yarn" and not [a for a in args if not a.startswith("-")] and not any(a in ("--version", "-v", "--help", "-h") for a in args):
            return "yarn without a command installs"
        return None
    if name == "crontab" and args != ["-l"]:
        return "crontab changes scheduled jobs"
    if name == "defaults" and args[:1] not in (["read"], ["read-type"], ["domains"], ["find"], ["export"]):
        return "defaults changes settings"
    if name == "xattr" and any(letter in "wdcr" for a in args for letter, _ in shorts(a)):
        return "xattr changes files"
    if name in SQL_CLIENTS:
        return sql_refusal(name, args)
    if name == "redis-cli":
        return redis_refusal(args)
    if profile == "investigate":
        # Run by path from outside the system's folders: the project's own script.
        if "/" in path and not path.lower().startswith(SYSTEM_BIN):
            return None
        return investigate_refusal(name, args, words)
    return None


# What an investigation may run: commands that only read (or restart in place), by name. Anything
# else needs a rule above that lets it through, or it is refused.
READERS = {
    "ls", "cat", "head", "tail", "wc", "grep", "egrep", "fgrep", "zgrep", "rg", "ag", "stat", "file", "du", "df",
    "date", "uptime", "whoami", "id", "hostname", "uname", "sw_vers", "which", "type", "echo", "printf", "true",
    "false", "test", "[", "sleep", "ps", "pgrep", "pidof", "lsof", "netstat", "nslookup", "dig", "host",
    "dscacheutil", "ping", "traceroute", "uniq", "cut", "tr", "jq", "yq", "column", "nl", "rev", "tac", "fold",
    "paste", "join", "comm", "diff", "cmp", "md5", "md5sum", "shasum", "sha256sum", "base64", "xxd", "od",
    "strings", "basename", "dirname", "realpath", "readlink", "tree", "pwd", "cd", "vm_stat", "iostat",
    "ioreg", "system_profiler", "mdfind", "mdls", "zcat", "gzcat", "bzcat", "xzcat", "journalctl", "less",
    "seq", "expr", "nproc", "sysctl", "pmset", "diskutil", "nc", "log", "top", "scutil", "networksetup",
    "plutil", "tmutil", "hdiutil", "csrutil", "defaults", "awk", "gawk", "nawk", "sed", "sort", "find",
    "xargs", "watch", "tee", "dd", "tar", "gzip", "gunzip", "bzip2", "bunzip2", "xz", "unxz", "zstd",
    "curl", "wget", "docker", "docker-compose", "launchctl", "systemctl", "brew", "kubectl", "bd", "git",
    "npm", "pnpm", "yarn", "bun", "uv", "eval", "unzip", "read", "exit", "return", "break", "continue",
    "wait", ":", "export", "local", "readonly", "declare", "typeset", "source", ".",
} | SHELLS | INTERPRETERS | SQL_CLIENTS | {"redis-cli"}
# A tool on the PATH of these folders is judged by its name; anything else run by path is a script.
SYSTEM_BIN = ("/bin/", "/sbin/", "/usr/bin/", "/usr/sbin/", "/usr/local/bin/", "/opt/homebrew/bin/", "/opt/homebrew/sbin/", "/usr/libexec/")
# GNU tools Homebrew installs with a g in front: judged as the tool itself.
G_TOOLS = {"rm", "mv", "cp", "ln", "sed", "awk", "dd", "shred", "truncate", "touch", "chmod", "chown", "install", "find", "tar", "sort", "split", "tee", "xargs", "date", "stat", "head", "tail", "cat", "ls", "grep", "du", "df", "readlink", "realpath", "timeout", "rmdir", "unlink", "mkdir"}
SECRET_DUMPERS = {"printenv": "prints every environment variable, secrets included", "security": "reads the Keychain"}
ENV_DUMPERS = {"env", "set", "export", "declare", "typeset", "compgen"}
DANGEROUS_ASSIGNMENTS = re.compile(r"^(GIT_[A-Z_]+|PAGER|MANPAGER|EDITOR|VISUAL|LD_[A-Z_]+|DYLD_[A-Z_]+|PROMPT_COMMAND|BASH_ENV|ENV|SHELLOPTS|IFS|PATH|PERL5OPT|PYTHONSTARTUP|NODE_OPTIONS)=")


def investigate_refusal(name, args, words):
    """The investigation's own rules: readers with a write mode, and anything not known as a reader."""
    if name in SECRET_DUMPERS:
        return f"{name} {SECRET_DUMPERS[name]}"
    if name in ENV_DUMPERS and not [a for a in args if not a.startswith("-")]:
        return f"{name} prints environment variables, secrets included"
    if name == "log" and args[:1] not in (["show"], ["stream"], ["stats"], ["help"]):
        return "log changes the system log"
    if name == "sysctl" and any(a == "-w" or "=" in a for a in args):
        return "sysctl -w changes the kernel"
    if name == "pmset" and args[:1] not in (["-g"],):
        return "pmset changes power settings"
    if name == "diskutil" and args[:1] not in (["list"], ["info"], ["apfs"]) or (name == "diskutil" and args[:1] == ["apfs"] and args[1:2] != ["list"]):
        return "diskutil changes disks"
    if name == "hdiutil" and args[:1] not in (["info"],):
        return "hdiutil changes disk images"
    if name == "tmutil" and args[:1] not in (["status"], ["listbackups"], ["latestbackup"], ["destinationinfo"]):
        return "tmutil changes backups"
    if name == "scutil" and not any(a in ("--get", "--dns", "--proxy", "--nwi", "-r") for a in args):
        return "scutil changes network settings"
    if name == "networksetup" and not all(a.startswith(("-get", "-list")) or not a.startswith("-") for a in args):
        return "networksetup changes network settings"
    if name == "plutil" and args[:1] not in (["-p"], ["-lint"], ["-help"]):
        return "plutil writes property lists"
    if name == "csrutil" and args[:1] != ["status"]:
        return "csrutil changes system protection"
    if name == "nc" and ("-z" not in args or any(a in ("-e", "-c", "-X") for a in args)):
        return "nc can open a connection that sends data"
    if name == "top" and "-l" not in args:
        return "top needs -l (it never ends otherwise)"
    if name == "less":
        return "less waits for a keyboard"
    if name == "bd" and args[:1] not in (["list"], ["show"], ["ready"], ["search"], ["stats"], ["comments"], ["blocked"], ["memories"], ["status"]):
        return "bd changes the tracker; an investigation only reads it"
    if name == "kubectl":
        k = first_positional(args, {"-n", "--namespace", "--context", "-l"})
        sub = args[k] if k is not None else ""
        if sub == "rollout" and args[k + 1:k + 2] in (["restart"], ["status"], ["history"]):
            return None
        if sub == "config" and args[k + 1:k + 2] in (["view"], ["get-contexts"], ["current-context"]):
            return None
        if sub not in ("get", "describe", "logs", "top", "version", "cluster-info", "explain", "api-resources", "events", "auth"):
            return f"kubectl {sub} changes the cluster"
    if name in ("npm", "pnpm", "yarn", "bun", "uv"):
        k = first_positional(args)
        sub = args[k] if k is not None else ""
        if sub not in ("run", "test", "ls", "list", "view", "info", "outdated", "why", "explain", "--version", "-v", ""):
            return f"{name} {sub} changes installed software or runs unknown code"
    if name not in READERS and interpreter_key(name) not in INTERPRETERS:
        return f"{name} is not a command an investigation is known to use safely"
    return None


# Commands that put the contents of the files they are given in front of the worker.
CONTENT_READERS = {
    "cat", "head", "tail", "tac", "nl", "rev", "fold", "cut", "paste", "join", "comm", "sort", "uniq", "grep", "egrep",
    "fgrep", "zgrep", "rg", "ag", "awk", "gawk", "nawk", "sed", "jq", "yq", "column", "xxd", "od", "strings", "base64",
    "diff", "cmp", "zcat", "gzcat", "bzcat", "xzcat", "less", "source", ".", "plutil", "hexdump", "bat",
} | SHELLS


def unknown_refusal(words):
    """An investigation fails closed: a file argument that is only known after the shell expands it."""
    while words and words[0] in KEYWORDS:
        words = words[1:]
    _, words = strip_wrappers(words)
    if len(words) < 2:
        return None
    name = base(words[0])
    if name.startswith("g") and name[1:] in G_TOOLS:
        name = name[1:]
    args = words[1:]
    if name == "git":
        if any(getattr(a, "unknown", False) and ":" in a for a in args):
            return "a git path only known after the shell expands it"
        return None
    if name in CONTENT_READERS or interpreter_key(name) in INTERPRETERS:
        for a in args:
            if getattr(a, "unknown", False) and not a.startswith("-"):
                return f"{name} reads a file only known after the shell expands it: {a}"
    return None


# --- a whole command line ----------------------------------------------------------------------------

# Pieces a command line is cut into: chains, pipes, subshells.
CUTS = {"|", "||", "&&", ";", "&", "(", ")", "|&", ";;", "{", "}", "<(", ">(", "$("}
SAFE_REDIRECT_TARGETS = {"/dev/null", "/dev/stdout", "/dev/stderr"}
KEYWORDS = {"do", "then", "else", "elif", "while", "until", "if", "!", "{"}


def inner_commands(text):
    """The text of every $(...) and `...` in a command line, so it is checked too."""
    found = re.findall(r"`([^`]*)`", text)
    i = 0
    while True:
        start = text.find("$(", i)
        if start < 0:
            break
        depth, j = 1, start + 2
        while j < len(text) and depth > 0:
            if text[j] == "(":
                depth += 1
            elif text[j] == ")":
                depth -= 1
            j += 1
        found.append(text[start + 2:j - 1])
        i = j
    return found


def tokens(text):
    lexer = shlex.shlex(text.replace("\n", " ; "), posix=True, punctuation_chars=True)
    lexer.whitespace_split = True
    lexer.commenters = ""  # protect() has dropped the real comments
    return list(lexer)


def make_word(variant, unknown, alts):
    w = Word(unprotect(variant))
    w.glob = has_glob(variant)
    w.unknown = unknown
    w.alts = alts
    return w


def learn(words, raws, state):
    """What a finished simple command leaves behind: variables, and where the next one runs."""
    while words and words[0] in KEYWORDS:
        words, raws = words[1:], raws[1:]
    if not words:
        return
    name = base(words[0])
    assignments = raws if all(ASSIGNMENT.match(unprotect(r)) for r in raws) else (
        raws[1:] if name in ("export", "local", "readonly", "declare", "typeset") else [])
    for raw in assignments:
        m = re.match(r"([A-Za-z_][A-Za-z0-9_]*)\+?=(.*)$", raw, re.S)
        if m:
            value = m.group(2)
            if value == "~" or value.startswith("~/"):
                value = literal(HOME) + value[1:]
            outs, _ = substitute(value, state)
            state.env.setdefault(m.group(1), []).extend(unlit(o) for o in outs)
    if name in ("for", "select") and len(words) >= 3 and words[2] == "in":
        values = state.env.setdefault(words[1], [])
        for raw in raws[3:]:
            variants, _ = expand(raw, state)
            values.extend(unlit(v) for v in variants)
    if name in ("cd", "pushd"):
        target = next((r for r in raws[1:] if not unprotect(r).startswith("-")), None)
        if target is None:
            state.cwd = HOME
            return
        variants, unknown = expand(target, state)
        if unknown or len(variants) != 1 or has_glob(variants[0]):
            state.cwd = None
        else:
            here = unlit(variants[0])
            state.cwd = os.path.normpath(os.path.join(state.cwd, here)) if state.cwd or os.path.isabs(here) else None


def check_text(text, profile, session="", cwd=None, env=None):
    """Why a whole command line is refused, or None.

    `env` is what the shell around it has set: a command line run by `bash -c`, `eval` or `watch`
    sees those variables too.
    """
    cwd = cwd or os.getcwd()
    for inner in inner_commands(text):
        why = check_text(inner, profile, session, cwd, env)
        if why:
            return why
    protected, extglob = protect(text)
    if extglob:
        return "an extended glob (@(..), +(..), !(..), *(..)) the guard can't expand"
    try:
        raw = tokens(protected)
    except ValueError:
        if profile == "investigate":
            return "a command the guard can't parse"
        raw = protected.split()
    state = State(cwd, session)
    state.env = {k: list(v) for k, v in (env or {}).items()}

    def again(line):
        return check_text(line, profile, session, state.cwd, state.env)

    def check(simple):
        if not simple:
            return None
        prefix, words = strip_wrappers(simple)
        why = dangerous_assignment(prefix)
        if why:
            return why
        if words and base(words[0]) == "git":
            why, args = git_command(words)
            if why:
                return why
            if args:
                return refusal(args) or (git_read_refusal(args) if profile == "investigate" else None)
            return None
        return simple_refusal(simple, profile, check, again)

    simple, simple_raw = [], []

    def finish():
        nonlocal simple, simple_raw
        words, raws = simple, simple_raw
        simple, simple_raw = [], []
        why = check(words)
        if not why and profile == "investigate":
            why = unknown_refusal(words)
        if why:
            return why
        learn(words, raws, state)
        return None

    def reads(word):
        return reference_refusal(word, state)

    k = 0
    while k < len(raw):
        rw = raw[k]
        w = unprotect(rw)
        following = raw[k + 1] if k + 1 < len(raw) else ""
        if w in CUTS:
            why = finish()
            if why:
                return why
        elif ">" in w and set(w) <= set("<>&|0123456789"):
            # A redirection: fine to a file descriptor or /dev/null, refused to anything else.
            target = unprotect(following)
            if target == "(":
                k += 1  # `>(cmd)`: a command, checked as one
                continue
            why = reads(following)
            if why:
                return why
            if not (w.endswith("&") and re.match(r"^-?\d*$", target)) and target not in SAFE_REDIRECT_TARGETS:
                return f"redirection writes a file: {target}"
            k += 2
            continue
        elif "<" in w and set(w) <= set("<&0123456789"):
            # Input from a file or here-string: reading is fine. `<(cmd)` is a command; check it.
            if following != "(":
                why = reads(following)
                if why:
                    return why
            k += 1 if following == "(" else 2
            continue
        else:
            why = reads(rw)
            if why:
                return why
            variants, unknown = expand(rw, state)
            alts = [unprotect(v) for v in variants]
            simple_raw.append(rw)
            simple.extend(make_word(v, unknown, alts) for v in brace_expand(rw))
        k += 1
    return finish()


def refuse(why):
    sys.stderr.write(f"sidekick guard: refused ({why}). Stop and report that the main session should handle this.\n")
    return 2


def tool_refusal(tool, given, session, cwd):
    """The file tools: a path is a name, a Glob pattern or a Grep glob is a pattern."""
    state = State(cwd, session)
    for key in ("file_path", "path"):
        value = given.get(key)
        if isinstance(value, str) and value:
            if is_secret(value):
                return f"reading a credentials file: {value}"
            if is_other_session(value, session):
                return f"another Claude session's files: {value}"
    patterns = [given.get("glob")] if tool == "Grep" else [given.get("pattern")] if tool == "Glob" else []
    for value in patterns:
        if not isinstance(value, str) or not value:
            continue
        if is_secret(value):
            return f"reading a credentials file: {value}"
        candidates = [value]
        if tool == "Glob" and isinstance(given.get("path"), str) and not os.path.isabs(value) and not value.startswith("~"):
            candidates.append(os.path.join(given["path"], value))
        for c in candidates:
            why = reference_refusal(c.replace("${HOME}", HOME).replace("$HOME", HOME), state)
            if why:
                return why
    return None


def main():
    profile = sys.argv[1] if len(sys.argv) > 1 and sys.argv[1] in ("chore", "investigate") else "chore"
    try:
        event = json.load(sys.stdin)
    except Exception:
        return 0
    tool = event.get("tool_name") or "Bash"
    session = event.get("session_id") or ""
    given = event.get("tool_input") or {}
    cwd = event.get("cwd") or os.getcwd()
    try:
        if tool in ("Read", "Grep", "Glob"):
            why = tool_refusal(tool, given, session, cwd)
        else:
            why = check_text(given.get("command") or "", profile, session, cwd)
    except Exception as error:  # any exit but 2 lets the call through, so a guard that breaks must refuse
        why = f"the guard could not check this call ({type(error).__name__})"
    return refuse(why) if why else 0


if __name__ == "__main__":
    sys.exit(main())
