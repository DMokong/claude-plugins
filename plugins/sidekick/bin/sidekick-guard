#!/usr/bin/env python3
"""PreToolUse guard for the sidekick's worker session: refuses git commands that can lose work.

The worker's --disallowedTools prefix rules catch the common spellings; this catches the rest
(a flag after other arguments, `git -C dir ...`, a command chained after `&&`). Exit 2 blocks
the call and shows stderr to the worker; any other exit lets it through.
"""
import json
import re
import shlex
import sys

GLOBAL_WITH_VALUE = {"-C", "-c", "--git-dir", "--work-tree", "--namespace"}


def git_args(words):
    """The subcommand and its arguments of a git invocation, or None if it isn't one."""
    if not words or words[0] != "git":
        return None
    i = 1
    while i < len(words) and words[i].startswith("-"):
        i += 2 if words[i] in GLOBAL_WITH_VALUE else 1
    return words[i:] if i < len(words) else None


def refusal(args):
    sub, rest = args[0], args[1:]
    flags = set(rest)
    if sub == "push":
        if any(a in ("-f", "--force", "--mirror", "-d", "--delete", "--prune") or a.startswith("--force") for a in rest):
            return "force or deleting push"
        if any(a.startswith("+") or a.startswith(":") for a in rest):
            return "force refspec or remote delete"
    if sub == "reset" and ("--hard" in flags or "--merge" in flags or "--keep" in flags):
        return "reset that discards changes"
    if sub == "clean":
        return "git clean deletes untracked files"
    if sub == "branch" and ("-D" in flags or ("--delete" in flags and ("--force" in flags or "-f" in flags))):
        return "force-deleting a branch"
    if sub in ("checkout", "switch") and (flags & {"-f", "--force", "--discard-changes", "--", "."}):
        return "checkout over uncommitted changes"
    if sub == "restore" and not (flags & {"--staged", "-S"} and not flags & {"--worktree", "-W"}):
        return "restore discards working-tree changes"
    if sub == "stash" and rest[:1] in (["drop"], ["clear"]):
        return "dropping stashed work"
    if sub in ("filter-branch", "filter-repo"):
        return "history rewrite"
    if sub == "reflog" and rest[:1] in (["expire"], ["delete"]):
        return "expiring the reflog"
    if sub == "update-ref" and "-d" in flags:
        return "deleting a ref"
    if sub == "gc" and any(a.startswith("--prune") for a in rest):
        return "pruning objects"
    return None


def main():
    try:
        event = json.load(sys.stdin)
    except Exception:
        return 0
    command = (event.get("tool_input") or {}).get("command") or ""
    for segment in re.split(r"&&|\|\||;|\||\n", command):
        try:
            words = shlex.split(segment)
        except ValueError:
            words = segment.split()
        args = git_args(words)
        if args:
            why = refusal(args)
            if why:
                sys.stderr.write(f"sidekick guard: refused ({why}). Stop and report that the main session should handle this.\n")
                return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
