#!/usr/bin/env python3
"""PreToolUse guard for the sidekick's worker session: holds the data-loss line whichever tool asks.

usage: sidekick-guard [chore|investigate]   (the hook's JSON call on stdin; no argument = chore)

It refuses, in every profile:
- git commands that can lose work (force-push, reset --hard, clean, ...);
- any read of a credentials file (.env, .mcp.json, keys) and of another Claude session's files,
  however the shell is made to spell the name (globs, braces, variables, $'..', case);
- outside git, anything that deletes or overwrites files, changes or removes containers, jobs or
  data, kills processes, writes to an API, installs, runs as root, or runs inline code the guard
  can't see into. Restarts in place (launchctl kickstart, docker restart/start) are allowed.
In an investigation the guard works the other way round: only commands it knows how to read with
(and the restarts in place, and the project's own scripts, run by path) get through. Anything else is
refused, git is reads only, a command it can't parse is refused, and so is a file argument that is
only known after the shell expands it.

The worker's --disallowedTools prefix rules catch the common spellings; this catches the rest (a flag
after other arguments, `git -C dir ...`, a command chained after `&&`, hidden in `bash -lc` or
`$(...)`). Exit 2 blocks the call and shows stderr to the worker; any other exit lets it through.

How it reads a command line: the shell's own passes are done first, in the shell's order. Quoting
decides what stays literal (`'.e*'` is a regex, `.e*` is a glob), then braces, variables and `~` are
filled in, and the result is judged: a command by its lower-cased basename, behind any wrapper; a
word that is a pattern by whether it could be the name of a secret.
"""
import glob
import itertools
import json
import os
import re
import shlex
import sys
from functools import lru_cache

# --- the options of the commands below -----------------------------------------------------------


def long_in(arg, names, least=2):
    """Whether `arg` is `--name` or `--name=value` for one of `names`, or an abbreviation of one.

    getopt_long takes any prefix that is unique, so a prefix of a dangerous option counts as it.
    """
    if not arg.startswith("--") or len(arg) < 2 + least:
        return False
    given = arg[2:].split("=", 1)[0]
    return len(given) >= least and any(n.startswith(given) for n in names)


def shorts(arg, valued=""):
    """The letters of a bundle of short options (`-sXDELETE`) as (letter, value) pairs.

    A letter in `valued` takes the rest of the word as its value ('' if the value is the next word)
    and ends the bundle; the others have no value (None).
    """
    if len(arg) < 2 or arg[0] != "-" or arg[1] == "-":
        return []
    out = []
    for n, ch in enumerate(arg[1:], 1):
        if ch in valued:
            out.append((ch, arg[n + 1:]))
            break
        out.append((ch, None))
    return out


def letters_of(args):
    """Every short-option letter used in `args` (crude: attached values count as letters too)."""
    return set("".join(a[1:] for a in args if a.startswith("-") and not a.startswith("--") and len(a) > 1))


def positionals(args, valued=()):
    """The words that are not options, skipping the value of the options in `valued`."""
    out, i = [], 0
    while i < len(args):
        a = args[i]
        if a in valued:
            i += 2
            continue
        if not a.startswith("-") or a == "-":
            out.append(a)
        i += 1
    return out


# --- git -------------------------------------------------------------------------------------------

GLOBAL_WITH_VALUE = {"-C", "-c", "--git-dir", "--work-tree", "--namespace", "--config-env", "--super-prefix", "--attr-source"}


def git_command(words):
    """(why refused, the subcommand and its arguments) for a git invocation, options skipped with their values."""
    i = 1
    while i < len(words) and words[i].startswith("-"):
        w = words[i]
        if w.startswith("-c") or w.startswith(("--config-env", "--exec-path=")):
            return "git -c can make git run another program", None
        i += 2 if w in GLOBAL_WITH_VALUE else 1
    return None, (words[i:] if i < len(words) else None)


# Options that make git run another program, by the subcommands that take them.
GIT_RUNS_COMMANDS = {
    "fetch": ("--upload-pack", "--receive-pack", "--exec", "--config"),
    "pull": ("--upload-pack", "--receive-pack", "--exec", "--config"),
    "push": ("--upload-pack", "--receive-pack", "--exec", "--config"),
    "clone": ("--upload-pack", "--receive-pack", "--exec", "--config", "-u", "-c"),
    "ls-remote": ("--upload-pack", "--receive-pack", "--exec", "--config", "-u"),
    "archive": ("--upload-pack", "--receive-pack", "--exec", "--config"),
    "submodule": ("--upload-pack", "--receive-pack", "--exec", "--config"),
}


def refusal(args):
    sub, rest = args[0], args[1:]
    flags = set(rest)
    letters = letters_of(rest)
    is_long = lambda *names: any(long_in(a, names) for a in rest)
    if any(a.startswith(GIT_RUNS_COMMANDS.get(sub, ("\0",))) for a in rest):
        return "an option that makes git run another program"
    if sub == "grep" and ("O" in letters or is_long("open-files-in-pager")):
        return "git grep -O runs a program on the matches"
    if sub in ("log", "diff", "show", "whatchanged", "shortlog") and is_long("output"):
        return "git --output writes a file"
    if sub == "config" and not (flags & {"--get", "--get-all", "--get-regexp", "--list", "-l", "--show-origin"}) and rest[:1] not in (["get"], ["list"]):
        return "git config changes what git runs"
    if sub == "push":
        if letters & set("fd") or is_long("force", "force-with-lease", "force-if-includes", "mirror", "delete", "prune"):
            return "force or deleting push"
        if any(a.startswith("+") or a.startswith(":") for a in rest):
            return "force refspec or remote delete"
    if sub in ("fetch", "pull") and (any(a.startswith("+") for a in rest) or (sub == "fetch" and ("f" in letters or is_long("force")))):
        return "force fetch overwrites local branches"
    if sub == "reset" and is_long("hard", "merge", "keep"):
        return "reset that discards changes"
    if sub == "clean":
        return "git clean deletes untracked files"
    if sub == "branch":
        deleting = "d" in letters or is_long("delete")
        moving = "m" in letters or is_long("move")
        forcing = "f" in letters or is_long("force")
        if "D" in letters or "M" in letters or ((deleting or moving) and forcing):
            return "force-deleting or overwriting a branch"
    if sub in ("checkout", "switch") and (flags & {"--", "."} or "f" in letters or is_long("force", "discard-changes")):
        return "checkout over uncommitted changes"
    if sub == "restore":
        staged_only = ("S" in letters or is_long("staged")) and not ("W" in letters or is_long("worktree"))
        if not staged_only:
            return "restore discards working-tree changes"
    if sub == "stash" and rest[:1] in (["drop"], ["clear"]):
        return "dropping stashed work"
    if sub in ("filter-branch", "filter-repo"):
        return "history rewrite"
    if sub == "reflog" and rest[:1] in (["expire"], ["delete"]):
        return "expiring the reflog"
    if sub == "update-ref" and ("d" in letters or is_long("delete")):
        return "deleting a ref"
    if sub == "gc" and is_long("prune"):
        return "pruning objects"
    return None


# What an investigation may do with git: look.
GIT_READS = {"status", "log", "diff", "show", "rev-parse", "blame", "describe", "ls-files", "shortlog", "cat-file", "rev-list", "grep", "show-ref", "for-each-ref", "ls-remote"}


def git_read_refusal(args):
    sub, rest = args[0], args[1:]
    if sub in GIT_READS:
        return None
    if sub == "remote" and (not rest or rest[0] in ("-v", "show", "get-url")):
        return None
    if sub == "branch" and all(a in ("-a", "-r", "-v", "-vv", "--list", "--show-current") for a in rest):
        return None
    if sub == "stash" and rest[:1] in (["list"], ["show"]):
        return None
    if sub == "reflog" and rest[:1] in ([], ["show"]):
        return None
    return f"git {sub} changes the repository; an investigation only reads git"


# --- what a name or a path can be --------------------------------------------------------------------

SECRET_NAMES = {".env", ".mcp.json", ".netrc", ".pgpass", "id_rsa", "id_ed25519", "id_ecdsa"}
SECRET_SUFFIXES = (".pem", ".key", ".p12", ".pfx")
# A template beside the real file holds placeholders, not secrets.
TEMPLATE_ENDINGS = ("example", "sample", "template", "dist")
HOME = os.path.expanduser("~")
STORE = [c.lower() for c in os.path.join(HOME, ".claude", "projects").split(os.sep) if c]


def secret_name(name):
    """Whether one file name is a credentials file. The disk may not tell `.ENV` from `.env`, so nor do we."""
    n = name.strip().strip("'\"").lower()
    if n in SECRET_NAMES or n.endswith(SECRET_SUFFIXES):
        return True
    return n.startswith(".env.") and not n.endswith(TEMPLATE_ENDINGS)


def pieces_of(path):
    """The paths a word can hold: `HEAD:.env`, `<.env`, `--file=.env`, `-f.env`, `@.env`, `:(glob).env`."""
    for part in re.split(r"[:<>=@,]", path or ""):
        part = part.strip().strip("'\"")
        yield part
        short = re.match(r"-[A-Za-z]+", part)
        if short and len(part) > short.end():
            yield part[short.end():]


def is_secret(path):
    """Whether a path names a credentials file, spelled out."""
    for part in pieces_of(path):
        part = re.sub(r"^\([^)]*\)", "", part)
        if secret_name(os.path.basename(part.rstrip("/"))):
            return True
    return False


# --- the shell's own passes: quoting, braces, variables, globs --------------------------------------

# Inside the guard a character the shell would treat as syntax but which was quoted is swapped for a
# private one, so what is left of `*?[]{}$,~` after lexing is exactly what the shell acts on.
SPECIAL = "*?[]{}$`,~"
LIT = {c: chr(0xE000 + n) for n, c in enumerate(SPECIAL)}
DQ = chr(0xE0F0)  # a $ inside double quotes: it expands, but the result is not globbed
VARW = chr(0xE0F1)  # whatever a name the guard can't resolve may turn out to be
NL = chr(0xE0F3)  # a newline inside quotes: it belongs to the word, it does not end the command
QUOTED = {**LIT, "\n": NL}
UNMAP = {**{v: k for k, v in LIT.items()}, DQ: "$", NL: "\n"}
_TO_PLAIN = str.maketrans({**UNMAP, VARW: "$"})
_TO_TEXT = str.maketrans(UNMAP)


def unprotect(s):
    return s.translate(_TO_PLAIN)


def unlit(s):
    """The characters of a word, an unknown part left as the VARW mark."""
    return s.translate(_TO_TEXT)


def literal(s):
    return "".join(LIT.get(c, c) for c in s)


ANSI_ESCAPE = re.compile(r"\\(x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{1,4}|U[0-9a-fA-F]{1,8}|[0-7]{1,3}|.)", re.S)
ANSI_SIMPLE = {"a": "\a", "b": "\b", "e": "\x1b", "E": "\x1b", "f": "\f", "n": "\n", "r": "\r", "t": "\t", "v": "\v", "\\": "\\", "'": "'", '"': '"', "?": "?"}


def ansi_decode(raw):
    """What `$'...'` makes of the text between its quotes."""
    def one(m):
        s = m.group(1)
        try:
            if s[0] == "x":
                return chr(int(s[1:], 16))
            if s[0] in "uU":
                return chr(int(s[1:], 16))
            if s[0] in "01234567":
                return chr(int(s, 8) & 0xFF)
        except ValueError:
            return ""
        return ANSI_SIMPLE.get(s, "\\" + s)
    return ANSI_ESCAPE.sub(one, raw).replace("\0", "")


def protect(text):
    """(the command line with what the shell would not act on swapped for private characters, whether
    it holds an unquoted extended glob such as `.@(env)` or `*(N)`)

    Also what the lexer can't do: `$'..'` decoded, a comment dropped up to its line's end, and a
    backslash-newline joined, so a command can't hide behind either.
    """
    out, i, n, quote, extglob = [], 0, len(text), None, False
    while i < n:
        c = text[i]
        nxt = text[i + 1] if i + 1 < n else ""
        if quote == "'":
            if c == "'":
                quote = None
                out.append(c)
            else:
                out.append(QUOTED.get(c, c))
        elif quote == '"':
            if c == '"':
                quote = None
                out.append(c)
            elif c == "\\" and nxt:
                if nxt == "\n":
                    pass
                elif nxt in "$`":
                    out.append(LIT[nxt])
                elif nxt in '"\\':
                    out.append(c + nxt)
                else:
                    out.append(c + LIT.get(nxt, nxt))
                i += 1
            elif c == "$" and nxt == "{":
                end = text.find("}", i)
                end = n - 1 if end < 0 else end
                out.append(DQ + text[i + 1:end + 1])
                i = end
            elif c == "$":
                out.append(DQ)
            elif c == "`":
                out.append(c)
            else:
                out.append(QUOTED.get(c, c))
        else:
            if c == "\\" and nxt:
                if nxt == "\n":
                    pass
                elif nxt in SPECIAL:
                    out.append(LIT[nxt])
                else:
                    out.append(c + nxt)
                i += 1
            elif c == "'":
                quote = "'"
                out.append(c)
            elif c == '"':
                quote = '"'
                out.append(c)
            elif c == "$" and nxt == "'":
                j, raw = i + 2, []
                while j < n and text[j] != "'":
                    if text[j] == "\\" and j + 1 < n:
                        raw.append(text[j:j + 2])
                        j += 2
                    else:
                        raw.append(text[j])
                        j += 1
                body = ansi_decode("".join(raw))
                out.append("'" + "".join("'\\''" if ch == "'" else QUOTED.get(ch, ch) for ch in body) + "'")
                i = j
            elif c == "$" and nxt == '"':
                quote = '"'
                out.append('"')
                i += 1
            elif c == "$" and nxt == "{":
                end = text.find("}", i)
                end = n - 1 if end < 0 else end
                out.append(c + text[i + 1:end + 1])
                i = end
            elif c == "#" and (i == 0 or text[i - 1] in " \t\n;&|()<>"):
                while i + 1 < n and text[i + 1] != "\n":
                    i += 1
            else:
                extglob = extglob or (c in "@+!?*" and nxt == "(")
                out.append(c)
        i += 1
    return "".join(out), extglob


def has_glob(s):
    """Whether a word still holds a glob character the shell will act on."""
    return "*" in s or "?" in s or bool(re.search(r"\[\]?[^\]]+\]", s))


def brace_expand(s, cap=256):
    """`a{b,c}d` -> abd acd; `{1..3}` -> a word that could be anything. A `${` is not a brace."""
    i = 0
    while i < len(s):
        if s[i] == "{" and (i == 0 or s[i - 1] not in ("$", DQ)):
            depth, j, last, parts = 0, i, i + 1, []
            while j < len(s):
                ch = s[j]
                if ch == "{" and (j == i or s[j - 1] not in ("$", DQ)):
                    depth += 1
                elif ch == "}" and depth > 0:
                    depth -= 1
                    if depth == 0:
                        break
                elif ch == "," and depth == 1:
                    parts.append(s[last:j])
                    last = j + 1
                j += 1
            if j < len(s) and parts:
                parts.append(s[last:j])
                found = []
                for p in parts:
                    found.extend(brace_expand(s[:i] + p + s[j + 1:], cap))
                    if len(found) > cap:
                        return [s[:i] + VARW + s[j + 1:]]
                return found
            if j < len(s) and re.fullmatch(r"[^.{}]+\.\.[^.{}]+(\.\.[^.{}]+)?", s[i + 1:j]):
                return brace_expand(s[:i] + VARW + s[j + 1:], cap)
        i += 1
    return [s]


AMBIENT = ("HOME", "TMPDIR", "USER", "LOGNAME")


class State:
    """What a command line has set so far: variables (every value any of them was given) and the directory."""

    def __init__(self, cwd, session):
        self.env, self.cwd, self.session = {}, cwd, session

    def values(self, name):
        found = list(self.env.get(name, []))
        if name == "HOME":
            found.append(HOME)
        elif name in AMBIENT and os.environ.get(name):
            found.append(os.environ[name])
        return found


def substitute(s, state, depth=0):
    """Every string the variables of `s` can turn it into, and whether some part is unknown (VARW)."""
    unknown = False
    if "`" in s:
        s = re.sub(r"`[^`]*`", VARW, s).replace("`", VARW)
        unknown = True
    outs, pos = [""], 0
    while True:
        j = next((k for k in range(pos, len(s)) if s[k] in ("$", DQ)), -1)
        if j < 0:
            break
        marker, rest = s[j], s[j + 1:]
        wrap = literal if marker == DQ else (lambda v: v)
        if rest.startswith("{"):
            e = rest.find("}")
            body, end = (rest[1:], len(s)) if e < 0 else (rest[1:e], j + 2 + e)
            m = re.fullmatch(r"([A-Za-z_][A-Za-z0-9_]*)(?:(:?[-=])(.*))?", body, re.S)
            if not m:
                alts, unk = [VARW], True
            else:
                values = state.values(m.group(1))
                alts = [wrap(v) for v in values]
                unk = any(VARW in v for v in values)
                if m.group(2) and depth < 3:
                    more, more_unk = substitute(m.group(3) or "", state, depth + 1)
                    alts += more
                    unk = unk or more_unk
                if not values:
                    alts.append(VARW)
                    unk = True
        elif rest[:1].isalpha() or rest[:1] == "_":
            name = re.match(r"[A-Za-z_][A-Za-z0-9_]*", rest).group()
            end = j + 1 + len(name)
            values = state.values(name)
            alts = [wrap(v) for v in values] or [VARW]
            unk = not values or any(VARW in v for v in values)
        elif rest.startswith("("):
            depth_p, k = 0, j + 1
            while k < len(s):
                depth_p += (s[k] == "(") - (s[k] == ")")
                k += 1
                if depth_p == 0:
                    break
            alts, unk, end = [VARW], True, k
        else:
            alts, unk, end = [VARW], True, j + 1 + (1 if rest[:1] and rest[0] in "0123456789@*#?$!-" else 0)
        outs = [o + s[pos:j] + a for o in outs for a in alts][:256]
        unknown = unknown or unk
        pos = end
    return [o + s[pos:] for o in outs], unknown


def expand(word, state):
    """Every word the shell can make of one active word, and whether some part of it stays unknown."""
    if word.startswith("~") and (len(word) == 1 or word[1] == "/"):
        word = literal(HOME) + word[1:]
    found, unknown = [], False
    for b in brace_expand(word):
        outs, unk = substitute(b, state)
        found.extend(outs)
        unknown = unknown or unk
    return found[:256], unknown


# --- glob patterns against secret names -----------------------------------------------------------


def parse_pattern(s):
    """The elements of one path component: ('lit', c) ('any',) ('star',) ('var',) ('cls', negate, ranges)."""
    elems, i = [], 0
    while i < len(s):
        c = s[i]
        if c == "*":
            elems.append(("star",))
        elif c == "?":
            elems.append(("any",))
        elif c == VARW:
            elems.append(("var",))
        elif c == "[":
            m = re.match(r"\[([!^]?)(\]?(?:\[:[a-z]+:\]|[^\]])*)\]", s[i:])
            if m:
                body = m.group(2).lower()
                if "[:" in body:
                    elems.append(("cls", True, ()))  # [[:alpha:]]: could be anything
                    i += m.end()
                    continue
                ranges, k = [], 0
                while k < len(body):
                    if k + 2 < len(body) and body[k + 1] == "-":
                        ranges.append((body[k], body[k + 2]))
                        k += 3
                    else:
                        ranges.append((body[k], body[k]))
                        k += 1
                elems.append(("cls", bool(m.group(1)), tuple(ranges)))
                i += m.end()
                continue
            elems.append(("lit", "["))
        else:
            elems.append(("lit", unlit(c).lower()))
        i += 1
    return tuple(elems)


def cls_has(e, ch):
    inside = any(lo <= ch <= hi for lo, hi in e[2])
    return inside != e[1]


def glob_fullmatch(elems, s):
    """Whether the pattern matches the whole name, a leading dot only by a dot, a class or an unknown."""
    n, m = len(elems), len(s)

    @lru_cache(None)
    def go(i, j):
        if i == n:
            return j == m
        e = elems[i]
        if e[0] == "star":
            return go(i + 1, j) or (j < m and not (j == 0 and s[0] == ".") and go(i, j + 1))
        if e[0] == "var":
            return go(i + 1, j) or (j < m and go(i, j + 1))
        if j >= m:
            return False
        if e[0] == "any":
            return not (j == 0 and s[j] == ".") and go(i + 1, j + 1)
        if e[0] == "lit":
            return e[1] == s[j] and go(i + 1, j + 1)
        return cls_has(e, s[j]) and go(i + 1, j + 1)

    return go(0, 0)


def prefix_compat(elems, target):
    """Whether some name that the pattern matches starts with `target`, the pattern itself naming at least three of its characters.

    `.env.*` and `.env.l*` do; `$name.log` could be `.env.log` only if the unknown `$name` were `.env`.
    """
    n, m = len(elems), len(target)

    @lru_cache(None)
    def go(i, j, named):
        if j == m:
            return named >= 3
        if i == n:
            return False
        e = elems[i]
        if e[0] in ("star", "var"):
            # A glob star can't take a leading dot; an unknown can.
            reach = 0 if (e[0] == "star" and j == 0) else m - j
            return any(go(i + 1, j + k, named) for k in range(0, reach + 1))
        if e[0] == "any":
            return not (j == 0 and target[j] == ".") and go(i + 1, j + 1, named + 1)
        if e[0] == "lit":
            return e[1] == target[j] and go(i + 1, j + 1, named + 1)
        return cls_has(e, target[j]) and go(i + 1, j + 1, named + 1)

    return go(0, 0, 0)


def suffix_compat(elems, suffix):
    """Whether some name that the pattern matches ends with `suffix`, the pattern itself naming at least two of its characters.

    `README*` could be `README.pem`, but the pattern says nothing about the key; `*.p*` and `server.k*` do.
    """
    rev, want = elems[::-1], suffix[::-1]
    n, m = len(rev), len(want)

    @lru_cache(None)
    def go(i, j, named):
        if j == m:
            return named >= 2
        if i == n:
            return False
        e = rev[i]
        if e[0] in ("star", "var"):
            return any(go(i + 1, j + k, named) for k in range(0, m - j + 1))
        if e[0] == "any":
            return go(i + 1, j + 1, named + 1)
        if e[0] == "lit":
            return e[1] == want[j] and go(i + 1, j + 1, named + 1)
        return cls_has(e, want[j]) and go(i + 1, j + 1, named + 1)

    return go(0, 0, 0)


def pattern_hits_secret(elems):
    """Whether a pattern for a file name could be the name of a credentials file."""
    named = sum(1 for e in elems if e[0] == "lit")
    if named == 0:
        return False
    for secret in SECRET_NAMES:
        # A pattern that opens with the dot (or a class that could be one) says enough in one more
        # character; any other needs two of the name's own, so `$v` + "v" is not `.env`.
        opens_with_dot = elems[0][0] == "cls" or elems[0] == ("lit", ".")
        if (named >= 2 or (opens_with_dot and secret.startswith("."))) and glob_fullmatch(elems, secret):
            return True
    if prefix_compat(elems, ".env."):
        tail = ""
        for e in reversed(elems):
            if e[0] != "lit":
                break
            tail = e[1] + tail
        if not tail.endswith(TEMPLATE_ENDINGS):
            return True
    return any(suffix_compat(elems, s) for s in SECRET_SUFFIXES)


def store_refusal(p, state):
    """Why a path (maybe a pattern) reaches into another session's files, or None."""
    q = p
    if not os.path.isabs(unlit(q)):
        if not state.cwd:
            return None
        q = state.cwd + "/" + q
    comps = [c for c in os.path.normpath(q).split("/") if c]
    if len(comps) < len(STORE):
        return None
    for comp, want in zip(comps, STORE):
        if has_glob(comp) or VARW in comp:
            if not glob_fullmatch(parse_pattern(comp), want):
                return None
        elif unlit(comp).lower() != want:
            return None
    here = "/" + "/".join(unlit(c) for c in comps)
    if state.session and f"/{state.session}/tool-results" in here:
        return None
    return f"another Claude session's files: {unprotect(p)}"


def is_other_session(path, session):
    """Whether a path is inside Claude's session store, other than this worker's own saved output."""
    if not isinstance(path, str) or path == "":
        return False
    path = path.replace("${HOME}", HOME).replace("$HOME", HOME).strip("'\"")
    if path.startswith("~"):
        path = HOME + path[1:]
    return store_refusal(literal(path), State(None, session)) is not None


def path_refusal(p, state):
    base_name = p.rstrip("/").rsplit("/", 1)[-1]
    patterned = has_glob(base_name) or VARW in base_name
    if patterned:
        if pattern_hits_secret(parse_pattern(base_name)):
            return f"a credentials file: {unprotect(p)}"
    elif secret_name(unlit(base_name)):
        return f"a credentials file: {unprotect(p)}"
    if has_glob(p) and VARW not in p and sum(1 for c in p.split("/") if has_glob(c)) <= 3:
        # The shell reads the disk: so does the guard, for what only the directory can tell. (Not for
        # a pattern that would walk the whole disk; its file name was judged above.)
        mask = "".join(("[" + UNMAP[ch] + "]" if ch in UNMAP and UNMAP[ch] in "*?[" else UNMAP.get(ch, ch)) for ch in p)
        pattern = os.path.expanduser(mask)
        if not os.path.isabs(pattern) and state.cwd:
            pattern = os.path.join(glob.escape(state.cwd), pattern)
        try:
            for hit in itertools.islice(glob.iglob(pattern), 1000):
                if is_secret(hit):
                    return f"a credentials file: {unprotect(p)} (matches {os.path.basename(hit)})"
        except (OSError, re.error):
            pass
    return store_refusal(p, state)


POSIX_CLASS_BRACKET = re.compile(r"\[[!^]?(?:[^\]\[]|\[:[a-z]+:\])*\[:[a-z]+:\](?:[^\]\[]|\[:[a-z]+:\])*\]")


def reference_refusal(word, state):
    """Why an active word (or any of the words it can become) names a credentials file or another session's files."""
    variants, _ = expand(word, state)
    for v in variants:
        # A bracket holding a POSIX class (`[[:alpha:]_]`) could be any character; and its colons are not a separator.
        v = POSIX_CLASS_BRACKET.sub(VARW, v)
        for piece in re.split(r"[:<>=@,]", v):
            piece = piece.strip().strip("'\"")
            cands = [piece]
            short = re.match(r"-[A-Za-z]+", piece)
            if short and len(piece) > short.end():
                cands.append(piece[short.end():])
            for c in cands:
                c = re.sub(r"^\([^)]*\)", "", c)
                if c:
                    why = path_refusal(c, state)
                    if why:
                        return why
    return None


def script_refusal(program):
    """A credentials file named inside a sed or awk program (`r .env`, `getline < ".env"`)."""
    for tok in re.split(r"""[\s'";(){}<>|,=:]+""", program):
        if is_secret(tok):
            return f"a credentials file: {tok}"
    return None


