# Skill-creator eval workspaces — fixtures + with/without run outputs.
# Kept alongside the plugins they test, but OUTSIDE plugins/ so they are never
# copied into a built plugin cache. See claw-6smt release notes.
.eval-workspaces/

# Conductor stream directories hold absolute local paths and private tracker ids —
# they are working records, never part of this public repo.
docs/fable-streams/

# Written by Claude Code when a mod is loaded with --plugin-dir. Never committed.
plugins/*/.claude-plugin/types/
# A mod type-checked before the engine has written its types/ emits .js beside the sources
plugins/*/hooks/**/*.js
